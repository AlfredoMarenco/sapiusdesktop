{
  "name": "sapiusmacdetecter",
  "version": "1.0.0",
  "description": "Detector de direccion mac para servicio sapius",
  "license": "ISC",
  "author": "marencocode",
  "type": "commonjs",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.sapius.macdetecter",
    "productName": "Sapius MAC Detector",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "cscLink": "dev-certificate.pfx",
      "cscKeyPassword": "SapiusDev2026"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sapius MAC Detector"
    }
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "axios": "^1.15.0"
  }
}
