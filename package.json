{
  "name": "sapiusdesktop",
  "version": "1.0.6",
  "description": "Aula virtual de Sapius para escritorio",
  "license": "ISC",
  "author": "marencocode",
  "type": "commonjs",
  "main": "src/main/index.js",
  "scripts": {
    "start": "concurrently -k \"vite\" \"electron .\"",
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "build": "vite build && electron-builder build --win -p always",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.sapius.desktop",
    "productName": "Sapius Desktop",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "tray_icon.png",
      "cscLink": "dev-certificate.pfx",
      "cscKeyPassword": "SapiusDev2026"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sapius Desktop",
      "language": "1034"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://sapius.com.mx/updates/detector"
      }
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^41.2.0",
    "electron-builder": "^25.0.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "axios": "^1.15.0",
    "electron-updater": "^6.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
